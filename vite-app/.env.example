# --- pixelpunisher.x on Vercel -------------------------------------------
# Copy to .env locally, or set the same keys in the Vercel project settings.

# GitHub OAuth App credentials (server-side, used by /api/oauth-* functions).
# Register the app at https://github.com/settings/developers with the
# Authorization callback URL set to:  https://<your-domain>/  (the SPA origin)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: bake a client id into the SPA so the device-flow tab works
# without the serverless config endpoint. Client IDs are public-safe.
VITE_GITHUB_CLIENT_ID=
